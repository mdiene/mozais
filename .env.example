# ============================================================
# MOZAIS — variables d'environnement
# Copiez ce fichier en `.env.local` et complétez.
# `.env.local` ne doit jamais être versionné.
# ============================================================

# --- Site ---------------------------------------------------
# Sert au sitemap, au robots.txt et aux liens dans les e-mails.
NEXT_PUBLIC_SITE_URL=https://mozais.sn

# --- Resend (e-mails transactionnels) -----------------------
# Clé API : https://resend.com/api-keys
# Sans cette clé, le site fonctionne normalement : les e-mails
# sont journalisés dans la console au lieu d'être envoyés.
RESEND_API_KEY=

# Expéditeur. Le domaine doit être vérifié dans Resend
# (enregistrements SPF, DKIM et DMARC), sinon les messages
# partent en spam ou sont refusés.
MOZAIS_FROM_EMAIL="MOZAIS <bonjour@mozais.sn>"
MOZAIS_REPLY_TO=bonjour@mozais.sn

# Audience Resend pour l'infolettre du pied de page.
# https://resend.com/audiences
RESEND_AUDIENCE_ID=
